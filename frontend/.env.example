# FloodLens Frontend Environment Configuration (Example)
# Copy this file to .env.local for local development.

# MapTiler API Key for vector/dark basemap tiles (Free tier key from https://cloud.maptiler.com)
VITE_MAPTILER_API_KEY=your_maptiler_api_key_here

# FastAPI Backend URL
VITE_API_BASE_URL=http://localhost:8000
